            </div>
            <div class="roop-plan-price">
              <span class="current">{{pack_price | times: 1| money_without_currency | append: currency_symbol}}</span>
              <span class="old">{{ pack_compare_price | money_without_currency | append: currency_symbol}}</span>         </div>
          </div>
          <div class="roop-plan-row2">
            <div class="roop-plan-subtitle">{{ sous_titre_pack_1_mois }}</div>
            <div class="roop-plan-price">
              <span class="current">{{pack_price | times: 1| money_without_currency | append: currency_symbol}}</span>
              <span class="old">{{ pack_compare_price | money_without_currency | append: currency_symbol}}</span>
            </div>
          </div>
        </label>
    
    </div>
    
    <!-- Champ caché qui synchronise la quantité choisie -->
    <input type="hidden" id="selected-qty" name="quantity" value="1">
    <!-- Button: left label (white), paid price (yellow), old price (white, struck) -->
    <button id="add-to-cart-btn" type="button">
      <span class="btn-label">{{ settings.widget_pack_button_text }} |</span><span id="total-paid" class="btn-paid"></span><span id="total-price" class="btn-old"></span>
