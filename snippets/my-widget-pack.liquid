<div class="roop-widget-root">
    <div class="roop-widget">
      <!-- Choix principal -->
      <div id="plans-one" class="roop-plans active">
      <div class="title-abonnement">
      {{ settings.widget_pack_onetime_label }}
      </div>
    
      <input type="radio" id="3pots" name="plan-one" {% if settings.default_pack_onetime_option == '3' %}checked{% endif %}>
        <label for="3pots" class="roop-plan">
          <div class="best-offer center">{{ settings.widget_pack_best_offer_badge }}</div>
          <div class="roop-plan-header">
            <span class="roop-radio"></span>
            <div class="title-discount">
              <span class="roop-plan-title">{{ settings.widget_pack_onetime_3_title }}</span>
              <span class="roop-discount">{{ settings.widget_pack_economy_prefix }} {{ discount_percent | append: '%'}} </span>
            </div>
            <div class="roop-plan-price">
              <span class="current">{{pack_price | times: 3| money_without_currency | append: currency_symbol}}</span>
              <span class="old">{{ pack_compare_price | times: 3 | money_without_currency | append: currency_symbol}}</span>
             </div>
          </div>

          <div class="roop-plan-row2">
            <div class="roop-plan-subtitle">{{ sous_titre_pack_3_mois }}</div>
            <div class="roop-plan-price">
              <span class="current">{{pack_price | times: 3| money_without_currency | append: currency_symbol}}</span>
              <span class="old">{{ pack_compare_price | times: 3 | money_without_currency | append: currency_symbol}}</span>
            </div>
          </div>

        </label>
      
      <input type="radio" id="2pots" name="plan-one" {% if settings.default_pack_onetime_option == '2' %}checked{% endif %}>
        <label for="2pots" class="roop-plan">
          <div class="roop-plan-header">
            <span class="roop-radio"></span>
            <div class="title-discount">
              <span class="roop-plan-title">{{ settings.widget_pack_onetime_2_title }}</span>
              <span class="roop-discount">{{ settings.widget_pack_economy_prefix }} {{ discount_percent | append: '%'}} </span>
            </div>
            <div class="roop-plan-price">
               <span class="current">{{pack_price | times: 2| money_without_currency | append: currency_symbol}}</span>
              <span class="old">{{ pack_compare_price | times: 2 | money_without_currency | append: currency_symbol}}</span>
            </div>
          </div>
          <div class="roop-plan-row2">
            <div class="roop-plan-subtitle">{{ sous_titre_pack_2_mois }}</div>
            <div class="roop-plan-price">
              <span class="current">{{pack_price | times: 2| money_without_currency | append: currency_symbol}}</span>
              <span class="old">{{ pack_compare_price | times: 2 | money_without_currency | append: currency_symbol}}</span>
            </div>
          </div>
        </label>

      <input type="radio" id="1pot" name="plan-one" {% if settings.default_pack_onetime_option == '1' %}checked{% endif %}>
        <label for="1pot" class="roop-plan">
          <div class="roop-plan-header">
            <span class="roop-radio"></span>
            <div class="title-discount">
              <span class="roop-plan-title">{{ settings.widget_pack_onetime_1_title }}</span>
