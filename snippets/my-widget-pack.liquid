  <input type="hidden" id="reduction-3pots" value="{{ multiplicateur_3pots }}">
  <input type="hidden" id="reduction-2pots" value="{{ multiplicateur_2pots }}">
  <input type="hidden" id="reduction-1pots" value="{{ multiplicateur_1pots }}">
  <input type="hidden" id="selling-plan-6m" value="{{ selling_plan_6m }}">
  <input type="hidden" id="selling-plan-3m" value="{{ selling_plan_3m }}">
  <input type="hidden" id="selling-plan-1m" value="{{ selling_plan_1m }}">
  <input type="hidden" id="discount-6m" value="{{ reduction_abonnement_6mois | times: 100 | round }}">
  <input type="hidden" id="discount-3m" value="{{ reduction_abonnement_3mois | times: 100 | round }}">
  <input type="hidden" id="discount-1m" value="{{ reduction_abonnement_1mois | times: 100 | round }}">
  
  <input type="hidden" id="selected-selling-plan" value="">
  <input type="hidden" id="reduction-3pots-percent" value="{{ reduction_3pots_percent }}">
  <input type="hidden" id="reduction-2pots-percent" value="{{ reduction_2pots_percent }}">
  <input type="hidden" id="reduction-1pot-percent" value="{{ reduction_1pot_percent }}">
</div>
</div>
<script>
      // Symbole de devise dynamique
    const CURRENCY_SYMBOL = '{{ currency_symbol }}';
    const plansOne = document.getElementById("plans-one");
    let selectedQuantity = parseInt(document.getElementById("selected-qty").value, 10);

    // Widget Pack - Pas d'abonnements, seulement achat unique
    //console.log('Widget Pack initialisé');
    
    function toggleTooltip(el) {
    el.classList.toggle('active');
  }

  var coll = document.getElementsByClassName("collapsible");
  // initialize collapsible buttons (single, robust initializer)
  for (let i = 0; i < coll.length; i++) {
    const btn = coll[i];
    const content = btn.nextElementSibling;
    // set initial aria and visibility based on existing .active
    btn.setAttribute('aria-expanded', btn.classList.contains('active') ? 'true' : 'false');
    if (content) content.style.display = btn.classList.contains('active') ? 'block' : 'none';

    btn.addEventListener('click', function() {
      const isActive = this.classList.toggle('active');
      const content = this.nextElementSibling;
      this.setAttribute('aria-expanded', isActive ? 'true' : 'false');
      if (!content) return;
      content.style.display = isActive ? 'block' : 'none';
    });
  }
  function getSelectedQuantity() {
    let quantity = 1; // valeur par défaut

    // Widget Pack: toujours achat unique
    const checkedPlan = plansOne.querySelector("input[type=radio]:checked");
    if (checkedPlan) {
      const id = checkedPlan.id; // ex : "3pots"
      const match = id.match(/(\d+)/);
      if (match) quantity = parseInt(match[1], 10);
    }

    return quantity;
  }


  // Exemple d'utilisation
  //console.log("Quantité choisie :", getSelectedQuantity());

  function addToCart(variantId, quantity) {
    const body = {
      id: variantId,
      quantity: quantity
    };
    
    // Prix du pack (en cents depuis Liquid)
    const packPrice = {{ product.selected_or_first_available_variant.price }};
    const packComparePrice = {{ product.selected_or_first_available_variant.compare_at_price | default: 0 }};
    
    // Widget Pack: achat unique seulement
    const checkedPlan = plansOne.querySelector("input[type=radio]:checked");
    if (checkedPlan) {
      const planId = checkedPlan.id;
      let planLabel = '';
      let totalOriginalPrice = 0;
      let totalFinalPrice = 0;
      
      if (planId === "3pots") {
        planLabel = '3 pots';
        totalOriginalPrice = packComparePrice > 0 ? packComparePrice * 3 : packPrice * 3;
        totalFinalPrice = packPrice * 3;
      } else if (planId === "2pots") {
        planLabel = '2 pots';
        totalOriginalPrice = packComparePrice > 0 ? packComparePrice * 2 : packPrice * 2;
        totalFinalPrice = packPrice * 2;
      } else if (planId === "1pot") {
        planLabel = '1 pot';
        totalOriginalPrice = packComparePrice > 0 ? packComparePrice : packPrice;
        totalFinalPrice = packPrice;
      }
      
      const discountPercent = totalOriginalPrice > 0 && totalOriginalPrice > totalFinalPrice 
        ? Math.round((1 - totalFinalPrice / totalOriginalPrice) * 100) 
        : 0;
      
      body.properties = {
        '_Prix_Original': (totalOriginalPrice / 100).toFixed(2) + CURRENCY_SYMBOL,
        '_Prix_Final': (totalFinalPrice / 100).toFixed(2) + CURRENCY_SYMBOL,
        '_Plan_Label': planLabel
      };
      
      if (discountPercent > 0) {
        body.properties['_Réduction'] = discountPercent + '%';
      }
    }
    
    // Afficher un état de chargement sur le bouton
    const btn = document.getElementById('add-to-cart-btn');
    const originalText = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<span class="btn-label">Ajout...</span>';

    // 🔍 DEBUG : Afficher ce qui va être envoyé
    //console.log('🛒 Body complet envoyé:', JSON.stringify(body, null, 2));
    
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body)
    })
    .then(response => response.json())
    .then(data => {
      //console.log('✅ Produit ajouté avec succès :', data);
      //console.log('📦 Properties envoyées:', body.properties);
      
      // Restaurer le bouton
      btn.disabled = false;
      btn.innerHTML = originalText;
      
      // Débloquer l'ajout après un délai de 2 secondes
      setTimeout(() => {
        isAddingToCart = false;
        //console.log('✅ Prêt pour un nouvel ajout');
      }, 2000);
      
      // Rafraîchir Corner Cart
      corner.do();
    })
    .catch(error => {
      console.error('❌ Erreur addToCart:', error);
      btn.disabled = false;
      btn.innerHTML = originalText;
      
      // Débloquer immédiatement en cas d'erreur
      isAddingToCart = false;
    });
  }

  function updateSelectedQuantity() {
    const quantityInput = document.getElementById("selected-qty");

    // Widget Pack: toujours achat unique
    const checkedPlan = plansOne.querySelector("input[type=radio]:checked");
    if (checkedPlan) {
      const id = checkedPlan.id; // ex : "3pots"
      const match = id.match(/(\d+)/);
      if (match) {
        quantityInput.value = parseInt(match[1], 10);
        selectedQuantity = quantityInput.value;
      }
    }
  }

  // Mets à jour la quantité à chaque changement
  document.querySelectorAll('input[type="radio"]').forEach(radio => {
    radio.addEventListener('change', () => {
      updateSelectedQuantity();
      updateButtonPrice();
    });
  });

  // Initialisation au chargement
  updateSelectedQuantity();
  updateButtonPrice();

  // Système de blocage des ajouts multiples
  let isAddingToCart = false;
  
  document.getElementById('add-to-cart-btn').addEventListener('click', () => {
    const variantId = "{{ product.selected_or_first_available_variant.id }}";   
    const quantity = parseInt(document.getElementById("selected-qty").value, 10);
    
    // Bloquer si un ajout est en cours
    if (isAddingToCart) {
      //console.log('⏸️ Ajout en cours, veuillez patienter...');
      return;
    }
    
    // Debug : afficher ce qui va être envoyé
    /*
    console.log('🛒 Ajout au panier (Pack):', {
      variantId: variantId,
      quantity: quantity,
      type: 'ACHAT UNIQUE (PACK)'
    });
    */
    // Marquer comme ajout en cours
    isAddingToCart = true;
    
    // Widget Pack: pas de selling plan
    addToCart(variantId, quantity);
  });

  function updateButtonPrice() {
    const totalPriceEl = document.getElementById('total-price');
    const totalPaidEl = document.getElementById('total-paid');

    selectedQuantity = parseInt(document.getElementById("selected-qty").value, 10);
    
    // Prix du pack
    const packComparePrice = {{ product.selected_or_first_available_variant.compare_at_price | default: 0 }};
    const packPrice = {{ product.selected_or_first_available_variant.price }};
    
    // Prix barré (compare_at_price) × quantité
    let totalPrice = packComparePrice > 0 
      ? (packComparePrice * selectedQuantity / 100).toFixed(2)
      : (packPrice * selectedQuantity / 100).toFixed(2);
    
    // Prix payé (price) × quantité
    let totalPaid = (packPrice * selectedQuantity / 100).toFixed(2);
    
    totalPriceEl.textContent = `${totalPrice}${CURRENCY_SYMBOL}`;
    totalPaidEl.textContent = `${totalPaid}${CURRENCY_SYMBOL}`;

    // show old (struck) price only when it differs from the paid price
    const btnOld = document.querySelector('#add-to-cart-btn .btn-old');
    if (btnOld) {
      const paidNum = parseFloat(totalPaid);
      const priceNum = parseFloat(totalPrice);
      if (Math.abs(paidNum - priceNum) < 0.01) {
        btnOld.style.display = 'none';
      } else {
        btnOld.style.display = 'inline-flex';
      }
    }
  }

  document.getElementById("selected-qty").addEventListener("change", updateButtonPrice);
  updateButtonPrice();

  function aficherIDproduit() {
    return {{ product.selected_or_first_available_variant.id }};
  }
</script>