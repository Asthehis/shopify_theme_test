{% comment %} Symbole de devise dynamique {% endcomment %}
{% assign currency_symbol = cart.currency.symbol %}

{% assign reduction_1pot_percent = product.metafields.custom.discount_qty_1 | default: 0 | plus: 0 %}
{% assign reduction_1pot = reduction_1pot_percent | divided_by: 100.0 %}

{% assign reduction_2pots_percent = product.metafields.custom.discount_qty_2 | default: settings.discount_onetime_2 | default: 5 | plus: 0 %}
{% assign reduction_2pots = reduction_2pots_percent | divided_by: 100.0 %}

{% assign reduction_3pots_percent = product.metafields.custom.discount_qty_3 | default: settings.discount_onetime_3 | default: 10 | plus: 0 %}
{% assign reduction_3pots = reduction_3pots_percent | divided_by: 100.0 %}

{% comment %}
  Valeurs par défaut (sauvegarde si roop ne fournit pas de prix exploitable)
  Nous allons ensuite parcourir product.selling_plan_groups et, si possible,
  calculer la réduction exacte comme : 1 - (plan_price / variant_price).
  Les champs de plan testés : plan.price, plan.per_delivery_price, plan.options[...] (fallbacks).
{% endcomment %}


{% assign multiplicateur_3pots = 1 | minus: reduction_3pots %}
{% assign multiplicateur_2pots = 1 | minus: reduction_2pots %}
{% assign multiplicateur_1pots = 1 | minus: reduction_1pot %}


{% comment %} === DEBUG: Afficher toutes les propriétés du produit === {% endcomment %}
 {% comment %}
<script>
  console.log('=== DEBUG PRODUIT ===');
  console.log('Handle:', '{{ product.handle }}');
  console.log('Type:', '{{ product.type }}');
  console.log('Tags:', {{ product.tags | json }});
  console.log('Collections:', {{ product.collections | map: 'handle' | json }});
  console.log('Metafields custom:', {{ product.metafields.custom | json }});
  console.log('Variants count:', {{ product.variants.size }});
  console.log('Has only default variant:', {{ product.has_only_default_variant }});
  console.log('Selling plan groups:', {{ product.selling_plan_groups.size }});
  console.log('Vendor:', '{{ product.vendor }}');
  console.log('Product JSON complet:', {{ product | json }});
  console.log('Compare_at_price ', {{ product.selected_or_first_available_variant.compare_at_price | json }});

  console.log('Product JSON complet 2:', {{ product.selected_or_first_available_variant | json }});
</script>
{% endcomment %}

{% comment %}
  Calcul dynamique des réductions depuis les selling plans roop (si présents)
  - variant_price et plan_price sont en cents (entiers). Pour obtenir un ratio
    décimal on force un calcul flottant en multipliant par 1.0 avant la division.
  - On détecte le plan 1/3/6 mois via le nom du plan (downcase) contenant '1','3','6' or 'mois'.
{% endcomment %}
{% assign variant_price = product.selected_or_first_available_variant.price %}
{% if product.selling_plan_groups.size > 0 %}
  {% for group in product.selling_plan_groups %}
    {% for plan in group.selling_plans %}
      {% assign plan_name_lower = plan.name | downcase | default: '' %}

      {%- comment -%}
        Certains de vos selling plans n'exposent pas de prix champs (plan.price / per_delivery_price absent).
        Dans votre debug on a des noms de type "Livrez chaque mois, 15 % de réduction" — la réduction est encodée dans le nom.
        Stratégie :
        1) détecter la fréquence via plan.options.first.value ou via le nom
        2) essayer d'extraire une valeur numérique de pourcentage depuis le nom
        3) appliquer la réduction si trouvée (perc/100.0)
      {%- endcomment -%}

      {% comment %} Détection par ID des plans d'abonnement (multi-langue) {% endcomment %}
      {% comment %} extraire le pourcentage depuis price_adjustments {% endcomment %}
      {% assign perc = 0 %}
      {% if plan.price_adjustments.size > 0 %}
        {% assign price_adj = plan.price_adjustments.first %}
        {% if price_adj.value_type == 'percentage' and price_adj.value > 0 %}
          {% assign perc = price_adj.value %}
        {% endif %}
      {% endif %}

      {% comment %} Si on a trouvé un pourcentage, appliquer selon l'ID du plan {% endcomment %}
      {% if perc > 0 %}
        {% assign computed_reduction = perc | divided_by: 100.0 %}
        {% if plan.id == 3563552929 %}
          {% assign reduction_abonnement_6mois = computed_reduction %}
        {% elsif plan.id == 3557490849 %}
          {% assign reduction_abonnement_3mois = computed_reduction %}
        {% elsif plan.id == 3563585697 %}
          {% assign reduction_abonnement_1mois = computed_reduction %}
        {% endif %}
      {% endif %}
    {% endfor %}
  {% endfor %}
{% endif %}

{% assign multiplicateur_abonnement_6mois = 1 | minus: reduction_abonnement_6mois %}
{% assign multiplicateur_abonnement_3mois = 1 | minus: reduction_abonnement_3mois %}
{% assign multiplicateur_abonnement_1mois = 1 | minus: reduction_abonnement_1mois %}

{% comment %}
  ===== DEBUG roop SELLING PLANS (activez ce bloc pour voir tous les plans disponibles) =====
  Décommentez le code ci-dessous pour afficher tous les selling plans du produit dans la console :
{% endcomment %}
{% assign debug_roop = true %}
{% if debug_roop %}
  <script>
    console.log('=== DEBUG roop SELLING PLANS ===');
    console.log('JSON complet des selling_plan_groups:', {{ product.selling_plan_groups | json }});
    console.log('---');
    console.log('Tous les plans disponibles pour ce produit :');
    {% for group in product.selling_plan_groups %}
      console.log('Groupe: {{ group.name }}');
      {% for plan in group.selling_plans %}
        console.log('  - Plan ID: {{ plan.id }}');
        console.log('    Nom: {{ plan.name }}');
        console.log('    JSON plan complet:', {{ plan | json }});
        {% if plan.price_adjustments.size > 0 %}
          console.log('    price_adjustments trouvés:');
          {% for adj in plan.price_adjustments %}
            console.log('      - value: {{ adj.value }}, value_type: {{ adj.value_type }}');
          {% endfor %}
        {% endif %}
      {% if plan.price %}
        console.log('    plan.price: {{ plan.price }}');
      {% elsif plan.per_delivery_price %}
        console.log('    plan.per_delivery_price: {{ plan.per_delivery_price }}');
      {% elsif plan.options.size > 0 and plan.options.first.value %}
        {%- comment -%} parfois l'option contient le nombre d'unités, pas le prix — on laisse 0 {%- endcomment -%}
      {% endif %}
        console.log('    Description: {{ plan.description }}');
        {% if plan.options.size > 0 %}
          {% for option in plan.options %}
            console.log('    Option: {{ option.name }} = {{ option.value }}');
          {% endfor %}
        {% endif %}
      {% endfor %}
    {% endfor %}
    console.log('=================================');
    console.log('reductions calculées', { r1: '{{ reduction_abonnement_1mois }}', r3: '{{ reduction_abonnement_3mois }}', r6: '{{ reduction_abonnement_6mois }}' });
  </script>
