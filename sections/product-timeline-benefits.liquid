{% assign timeline = product.metafields.custom.timeline_benefices.value %}

{% if timeline %}
    <section class="timeline-benefits">
        <div class="timeline-container">
            {% if timeline.titre_de_la_section %}
            <h2 class="timeline-title">{{ timeline.titre_de_la_section }}</h2>
            {% endif %}
            
            {% if timeline.sous_titre %}
            <p class="timeline-subtitle">{{ timeline.sous_titre }}</p>
            {% endif %}

            <div class="timeline-content">
            <!-- Colonne gauche : Timeline -->
            <div class="timeline-left">
                {% assign etapes = timeline.etapes.value %}
                {% if etapes and etapes.size > 0 %}
                <div class="timeline-line"></div>
                <div class="timeline-steps-vertical">
                    {% for etape in etapes %}
                    <div class="timeline-step-item">
                        {% if etape.badge_semaine %}
                        <div class="step-badge">{{ etape.badge_semaine }}</div>
                        {% endif %}
                        <div class="step-content">
                        {% if etape.titre %}
                            <h3 class="step-title">{{ etape.titre }}</h3>
                        {% endif %}
                        {% if etape.description %}
                            <p class="step-description">{{ etape.description }}</p>
                        {% endif %}
                        </div>
                    </div>
                    {% endfor %}
                </div>
                {% endif %}

                {% if timeline.instructions %}
                <div class="timeline-instructions">
                    <div class="instructions-icon">💊</div>
                    <div class="instructions-content">
                    {{ timeline.instructions | metafield_tag }}
                    </div>
                </div>
                {% endif %}
            </div>

            <!-- Colonne droite : Images -->
            <div class="timeline-right">
                {% assign images = timeline.images_illustratives.value %}
                {% if images and images.size > 0 %}
                <div class="timeline-images-grid">
                    {% for image in images %}
                    <div class="timeline-image-item">
                        <img src="{{ image | image_url: width: 600 }}" alt="Illustration" loading="lazy">
                    </div>
                    {% endfor %}
                </div>
                {% endif %}
            </div>
            </div>
        </div>
    </section>
{% endif %}

<style>
        
    .timeline-benefits {
    padding: 60px 20px;
    background: #f9f7f4;
    }

    .timeline-container {
    max-width: 1200px;
    margin: 0 auto;
    }

    .timeline-title {
    font-size: 36px;
    font-weight: 600;
    margin-bottom: 16px;
    color: #1a1a1a;
    text-align: center;
    }

    .timeline-subtitle {
    font-size: 14px;
    color: #666;
    margin-bottom: 48px;
    text-align: center;
    max-width: 700px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.6;
    }

    .timeline-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: start;
    }

    /* Colonne gauche - Timeline */
    .timeline-left {
    position: relative;
    }

    .timeline-line {
    position: absolute;
    left: 18px;
    top: 30px;
    bottom: 120px;
    width: 2px;
    background: #ddd;
    z-index: 0;
    }

    .timeline-steps-vertical {
    position: relative;
    z-index: 1;
    }

    .timeline-step-item {
    display: flex;
    gap: 20px;
    margin-bottom: 32px;
    align-items: flex-start;
    }

    .step-badge {
    flex-shrink: 0;
    background: #ffc107;
    color: white;
    padding: 8px 14px;
    border-radius: 20px;
    font-size: 11px;
    font-weight: 600;
    text-transform: capitalize;
    white-space: nowrap;
    }

    .step-content {
    flex: 1;
    }

    .step-title {
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 8px;
    color: #1a1a1a;
    }

    .step-description {
    font-size: 13px;
    color: #666;
    line-height: 1.6;
    }

    .timeline-instructions {
    margin-top: 40px;
    padding: 20px;
    background: #f5f5f5;
    border-radius: 8px;
    display: flex;
    gap: 16px;
    align-items: flex-start;
    }

    .instructions-icon {
    font-size: 32px;
    flex-shrink: 0;
    }

    .instructions-content {
    flex: 1;
    font-size: 13px;
    color: #333;
    }

    .instructions-content h4 {
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 8px;
    color: #1a1a1a;
    }

    .instructions-content ul {
    margin: 0;
    padding-left: 20px;
    }

    .instructions-content li {
    margin-bottom: 4px;
    font-size: 13px;
    color: #666;
    }

    /* Colonne droite - Images */
    .timeline-right {
    position: sticky;
    top: 20px;
    }

    .timeline-images-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 16px;
    min-height: 500px;
    }

    .timeline-image-item {
    overflow: hidden;
    }

    .timeline-image-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    }

    /* Image 1 - Grande rectangulaire verticale à gauche */
    .timeline-image-item:nth-child(1) {
    background: red; /* Test */
    grid-column: 1 / 2;
    grid-row: 1 / 3;
    border-radius: 24px;
    }

    /* Image 2 - Ronde en haut à droite */
    .timeline-image-item:nth-child(2) {
    grid-column: 2 / 3;
    grid-row: 1 / 2;
    border-radius: 50%;
    }

    /* Image 3 - Ronde en bas à droite */
    .timeline-image-item:nth-child(3) {
    grid-column: 2 / 3;
    grid-row: 2 / 3;
    border-radius: 50%;
    }

    @media (max-width: 968px) {
        .timeline-content {
            grid-template-columns: 1fr;
            gap: 40px;
        }
        
        .timeline-right {
            position: static;
        }
        
        .timeline-title {
            font-size: 28px;
        }
        
        .timeline-images-grid {
            grid-template-columns: 1fr;
            grid-template-rows: auto;
            min-height: auto;
        }
        
        .timeline-image-item:nth-child(1),
        .timeline-image-item:nth-child(2),
        .timeline-image-item:nth-child(3) {
            grid-column: 1;
            grid-row: auto;
            border-radius: 16px;
        }
        
        .timeline-image-item:nth-child(2),
        .timeline-image-item:nth-child(3) {
            aspect-ratio: 16/9;
        }
    }
</style>

{% schema %}
    {
    "name": "Timeline Bénéfices",
    "settings": [],
    "presets": [
        {
        "name": "Timeline Bénéfices"
        }
    ]
    }
{% endschema %}