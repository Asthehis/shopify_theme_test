{% comment %}
Section: ou-nous-trouver
Settings:
- data_source: 'asset' or 'manual'
- asset_filename: asset filename (ex: assets/pharmacies.json)
- manual_json: paste JSON array manually
- show_list: boolean to show the left list
This section will render a Leaflet map and load pharmacies either from an asset file or from the manual JSON field.
{% endcomment %}

<style>

  @import url('https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600;700&display=swap');
  /* Mobile (425px et moins) - 100% de largeur */
  .ou-nous-trouver { 
    display: flex; 
    flex-direction: column; /* ← Changé pour empiler verticalement */
    gap: 40px; /* ← Espace entre le contenu et la CTA */
    align-items: stretch; 
    background: transparent; 
    padding: 0;
    width: 100%;
    margin: 0 auto; 
    box-sizing: border-box;
    z-index: 1; /* AJOUTÉ - Section entière sous le header/menu */
  }

  /* Nouveau wrapper pour liste + carte */
  .ou-nous-trouver__content {
    display: flex;
    gap: 0;
    align-items: stretch;
    width: 100%;
  }

  .ou-nous-trouver__list { 
    flex: 0 0 30%; 
    width: 30%;
    min-width: unset;
    max-width: 30%;
    max-height: 550px; 
    overflow-y: visible;
    overflow-x: hidden;
    background: transparent;
    padding: 0 18.62px 0 0;
    border-right: 1px solid #e9e9ef;
    position: relative;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    z-index: 1; /* AJOUTÉ - Même z-index que la carte pour cohérence */
  }

  .ou-nous-trouver__list ul {
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
    max-width: 100%;
    height: auto;
    max-height: 500px;
    overflow-y: auto;
    overflow-x: hidden;
    position: relative;
  }

  .ou-nous-trouver__list li {
    margin-bottom: 0;
    padding: 1rem 0.5rem;
    border-bottom: 1px solid #f0f0f0;
    cursor: pointer;
    transition: background 0.2s;
  }

  .ou-nous-trouver__list li:hover {
    background: #f8f9fa;
  }

  .ou-nous-trouver__search-wrapper {
    position: relative;
    margin-bottom: 1rem;
    width: 100%;
    height: auto;
    display: flex;
    gap: 0;
    box-sizing: border-box;
  }

  .ou-nous-trouver__search-wrapper input {
    flex: 1;
    min-width: 0;
    height: 48.88px;
    padding: 0.75rem 1rem;
    border: 1px solid #dcdcef;
    border-right: 1px solid #dcdcef;
    border-radius: 6px;
    font-size: 14px;
    background: #fff;
    box-sizing: border-box;
  }

  .ou-nous-trouver__search-wrapper button {
    flex: 0 0 55.86px;
    width: 55.86px;
    height: 48.88px;
    padding: 0;
    background: #322B81;
    border: none;
    border-radius: 6px;
    color: #FFCC00;
    cursor: pointer;
    font-size: 20px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-left: 8px;
  }

  .ou-nous-trouver__map {
    flex: 1; /* Prend l'espace restant (70%) */
    min-height: 500px; /* Hauteur minimale pour la carte */
  }

  .pharmacy-item {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }
  .pharmacy-item__icon {
    color: #333333;
    width: 19px;
    height: 25px;
    flex-shrink: 0;
    margin-top: 2px;
  }
  .pharmacy-item__icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }
  .pharmacy-item__content h3 {
    margin: 0 0 0.25rem 0;
    font-size: 15px;
    font-weight: 600;
    color: #2e408b;
  }
  .pharmacy-item__content p {
    margin: 0;
    font-size: 13px;
    color: #666;
    line-height: 1.4;
  }
  .ou-nous-trouver__map { 
    flex: 1; 
    width: 70%; /* AJOUTÉ - prend les 70% restants */
    min-width: unset; /* MODIFIÉ - supprime le min-width de 400px */
    max-width: 70%; /* AJOUTÉ - limite à 70% */
    height: 550px; 
    min-height: 550px; 
    position: relative;
    border-radius: 10px;
    overflow: hidden;
    background: #eef2f5;
    box-sizing: border-box; /* AJOUTÉ */
    z-index: 1; /* AJOUTÉ - Assure que la carte reste sous le header/menu (qui ont généralement z-index: 100+) */
  }
  /* Add vertical spacing for map and list */
  .ou-nous-trouver__map,
  .ou-nous-trouver__list {
    margin-top: clamp(20px, 3vw, 60px);
    margin-bottom: clamp(20px, 3vw, 60px);
  }
  /* Hide the "Leaflet" credit only (preserve OSM/CARTO attributions).
     Target common Leaflet href patterns; keeps other attribution links visible. */
  #ou-nous-trouver-map-{{ section.id }} .leaflet-control-attribution a[href*="leaflet"],
  #ou-nous-trouver-map-{{ section.id }} .leaflet-control-attribution a[href*="leafletjs"] {
    display: none !important;
  }
  
  /*style pour la CTA*/
  .frame,
  .frame * {
    box-sizing: border-box;
  }

  .frame {
    background: #ffffff;
    border-radius: 110px;
    border-style: solid;
    border-color: #f6f3ea;
    border-width: 1px;
    padding: clamp(15px, 2vw, 30px) clamp(20px, 4vw, 60px);
    display: flex;
    flex-direction: row;
    gap: 10px;
    align-items: flex-start;
    justify-content: flex-start;
    flex-shrink: 0;
    position: relative;
    
    /* --- AJOUTS POUR LE CENTRAGE ET LA LARGEUR --- */
    width: 100%;
    max-width: 1100px; /* Empêche la barre de devenir trop longue sur grands écrans */
    margin-left: auto; /* Centre la barre à gauche */
    margin-right: auto; /* Centre la barre à droite */
    
    margin-bottom: clamp(30px, 5vw, 60px);
  }

  .cta {
    display: flex;
    flex-direction: row;
    gap: clamp(20px, 5vw, 80px);
    align-items: center;
    justify-content: flex-start;
    flex: 1;
    position: relative;
  }

  .content {
    display: flex;
    flex-direction: column;
    gap: clamp(12px, 2vw, 24px);
    align-items: flex-start;
    justify-content: flex-start;
    flex: 1;
    position: relative;
  }

  .row {
    display: flex;
    flex-direction: column;
    gap: 10px;
    align-items: flex-start;
    justify-content: flex-start;
    flex-shrink: 0;
    width: 100%;
    max-width: 768px;
    position: relative;
  }

  .heading {
    color: #322b81;
    text-align: left;
    font-family: "Jost", sans-serif;
    font-size: clamp(18px, 1.6vw, 30px);
    line-height: 120%;
    font-weight: 600;
    position: relative;
    align-self: stretch;
  }

  .text {
    color: var(--text-primary, #000000);
    text-align: left;
    font-family: "Jost", sans-serif;
    font-size: clamp(14px, 1.1vw, 18px);
    line-height: 110%;
    font-weight: 400;
    position: relative;
    align-self: stretch;
  }

  .actions {
    display: flex;
    flex-direction: row;
    gap: 16px;
    align-items: flex-start;
    justify-content: flex-end;
    flex-shrink: 0;
    position: relative;
  }

  .button {
    background: #322b81;
    border-radius: 20px;
    padding: clamp(8px, 1vw, 10px) clamp(15px, 2vw, 20px);
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    cursor: pointer;
    transition: background 0.3s ease;
    color: #ffffff;
    text-align: center;
    font-family: "Jost", sans-serif;
    font-size: clamp(12px, 1.3vw, 16px);
    line-height: 16px;
    font-weight: 400;
  }

  .button:hover {
    background: #4a3fa8;
  }

  .devenir-partenaire {
    color: #ffffff;
    text-align: center;
    font-family: "Jost", sans-serif;
    font-size: clamp(12px, 1.3vw, 16px);
    line-height: 16px;
    font-weight: 400;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Media queries pour mobile */
  @media (max-width: 768px) {
    .frame {
      border-radius: 40px;
      padding: 26px;
      margin-bottom: 40px;
    }
    
    .cta {
      flex-direction: column;
      gap: 20px;
    }
    
    .actions {
      justify-content: center;
      width: 100%;
    }
    
    .button {
      width: 100%;
    }
  }

    /* Media queries pour 425px à 768px - bouton à gauche, largeur auto */
  @media (min-width: 425px) and (max-width: 768px) {
    .frame {
      border-radius: 40px;
      padding: 26px;
      margin-bottom: 40px;
    }
    
    .cta {
      flex-direction: column;
      gap: 20px;
    }
    
    .actions {
      justify-content: flex-start; /* Alignement à gauche */
      width: 100%;
    }
    
    .button {
      width: auto; /* Largeur automatique selon le contenu */
    }
  }
  /* Media queries pour tablette */
  @media (min-width: 769px) and (max-width: 1024px) {
    .frame {
        border-radius: 60px;
        width: 92%; /* La barre prend 92% de la largeur pour laisser une petite marge sur les côtés */
      }
      
      /* Optionnel : Rapprocher un peu le texte et le bouton sur tablette */
      .cta {
        gap: 40px; 
      }
  }
  @media (max-width: 768px) {
    .ou-nous-trouver__content {
      flex-direction: column;
    }
    
    .ou-nous-trouver__list {
      width: 100%;
      max-width: 100%;
      border-right: none;
      border-bottom: 1px solid #e9e9ef;
      padding: 0 0 18.62px 0;
      margin-bottom: 20px;
    }
  }

  @media (max-width: 425px) { 
    .ou-nous-trouver { 
      flex-direction: column; 
      padding: 0 16px; /* MODIFIÉ - plus de padding */
      width: 100% !important;
      max-width: 100% !important;
      box-sizing: border-box; /* AJOUTÉ */
    }
    
    .ou-nous-trouver__list { 
      width: 100%; 
      min-width: auto !important;
      max-width: 100% !important;
      max-height: none; 
      border-right: none; 
      border-bottom: 1px solid #e0e0e0; 
      padding: 0; /* MODIFIÉ - supprime le padding right */
      margin-bottom: 16px; /* MODIFIÉ - 16px au lieu de 12px */
      box-sizing: border-box; /* AJOUTÉ */
    }
    
    .ou-nous-trouver__list ul {
      max-width: 100%;
      box-sizing: border-box; /* AJOUTÉ */
      padding-right: 0; /* AJOUTÉ - supprime tout padding */
    }
    
    .ou-nous-trouver__search-wrapper {
      width: 100%;
      max-width: 100%;
      box-sizing: border-box; /* AJOUTÉ */
      margin-bottom: 1rem;
    }
    
    .ou-nous-trouver__search-wrapper input {
      flex: 1;
      min-width: 0; /* AJOUTÉ - permet au input de rétrécir */
      box-sizing: border-box; /* AJOUTÉ */
    }
    
    .ou-nous-trouver__search-wrapper button {
      flex-shrink: 0; /* AJOUTÉ - empêche le bouton de rétrécir */
    }
    
    .ou-nous-trouver__map { 
      width: 100% !important;
      max-width: 100% !important;
      height: 276px !important;
      min-height: 276px !important;
      min-width: auto !important;
      margin-left: 0; /* MODIFIÉ - au lieu de auto */
      margin-right: 0; /* MODIFIÉ - au lieu de auto */
      box-sizing: border-box; /* AJOUTÉ */
      border-radius: 10px; /* AJOUTÉ - garde le border-radius */
    }

    /* Mobile: afficher la carte AVANT la liste */
    .ou-nous-trouver__map { order: -1; }
    .ou-nous-trouver__list { order: 0; }
    
    /* Mobile: reduce vertical spacing */
    .ou-nous-trouver__map,
    .ou-nous-trouver__list {
      margin-top: 0;
      margin-bottom: 20px;
    }
    
    /* AJOUTÉ - S'assurer que les items de liste ne débordent pas */
    .ou-nous-trouver__list li {
      box-sizing: border-box;
      width: 100%;
    }
    
    .pharmacy-item {
      box-sizing: border-box;
      width: 100%;
    }
  }
  @media screen and (min-width: 426px) {
    .ou-nous-trouver { 
      width: 70%; 
      max-width: 70%;
    }
  }

  @media screen and (min-width: 426px) and (max-width: 768px) {
    /* Tablette petite (426-767px) */
    .ou-nous-trouver {
      width: 95% !important;
      max-width: 95% !important;
      padding: 0 0.5rem;
      justify-content: center;
      gap: 0.75rem;
    }
    
    /* Pour les petits écrans (426-600px) : layout vertical */
    @media (max-width: 600px) {
      .ou-nous-trouver__content {
        flex-direction: column !important;
      }
      
      .ou-nous-trouver__map { 
        order: -1 !important; 
      }
      
      .ou-nous-trouver__list { 
        order: 0 !important; 
      }
      
      .ou-nous-trouver__list {
        flex: 1 1 100% !important;
        width: 100% !important;
        max-width: 100% !important;
        min-width: 0 !important;
        max-height: 350px !important;
        border-right: none !important;
        border-bottom: 1px solid #e9e9ef !important;
        margin-bottom: 1rem !important;
        padding: 0 0 18.62px 0 !important;
      }
      
      .ou-nous-trouver__map {
        flex: 1 1 100% !important;
        width: 100% !important;
        max-width: 100% !important;
        min-width: 0 !important;
        height: 350px !important;
        min-height: 350px !important;
        max-height: 350px !important;
      }
    }
    
    /* Pour les écrans moyens (601-767px) : layout horizontal avec flex */
    @media (min-width: 601px) {
      .ou-nous-trouver__content {
        flex-direction: row !important;
        gap: 0.75rem;
      }
      
      .ou-nous-trouver__list {
        flex: 0 0 35% !important; /* ← Pourcentage au lieu de px */
        width: 35% !important;
        max-width: 35% !important;
        min-width: 0 !important;
        max-height: 380px !important;
      }
      
      .ou-nous-trouver__list ul {
        max-height: 320px !important;
      }

      .ou-nous-trouver__map {
        flex: 1 !important; /* ← Prend l'espace restant */
        width: auto !important;
        max-width: none !important;
        min-width: 0 !important;
        height: 380px !important;
        min-height: 380px !important;
        max-height: 380px !important;
      }
    }
  }

  @media screen and (min-width: 768px) and (max-width: 1023px) {
    .ou-nous-trouver {
      width: 100% !important; /* ← Changé à 100% */
      max-width: 100% !important;
      padding: 0;
      align-items: center; /* ← Centre les enfants */
    }
    
    .ou-nous-trouver__content {
      width: 85% !important; /* ← Déplacé ici */
      max-width: 85% !important;
      gap: 1.5rem;
      justify-content: center;
    }

    .frame {
      width: 85% !important; /* ← Déplacé ici */
      max-width: 85% !important;
    }
    
    .ou-nous-trouver__list {
      flex: 0 0 240px !important;
      width: 240px !important;
      max-width: 240px !important;
      min-width: 240px !important;
      max-height: 400px !important;
    }
    
    .ou-nous-trouver__list ul {
      max-height: 340px !important;
      max-width: 100% !important;
    }

    /* Carte CARRÉE : 400x400 pour mieux s'adapter */
    .ou-nous-trouver__map {
      flex: 0 0 400px !important;
      width: 400px !important;
      max-width: 400px !important;
      min-width: 400px !important;
      height: 400px !important;
      min-height: 400px !important;
      max-height: 400px !important;
    }

    .ou-nous-trouver__map,
    .ou-nous-trouver__list {
      margin-top: 40px !important;
      margin-bottom: 40px !important;
    }
    
    /* La CTA aura aussi 85% de largeur et sera centrée */
    .frame {
      width: 85% !important;
      max-width: 85% !important;
    }
    
    .ou-nous-trouver__search-wrapper input {
      height: 44px;
      font-size: 13px;
      padding: 0.65rem 0.85rem;
    }
    
    .ou-nous-trouver__search-wrapper button {
      flex: 0 0 50px;
      width: 50px;
      height: 44px;
      font-size: 18px;
    }
    
    .pharmacy-item {
      gap: 0.6rem;
    }
    
    .pharmacy-item__content h3 {
      font-size: 14px;
    }
    
    .pharmacy-item__content p {
      font-size: 12px;
    }
    
    .ou-nous-trouver__list li {
      padding: 0.85rem 0.4rem;
    }
  }

  /* Cluster styles - comme votre template */
  .marker-cluster-small {
    background-color: rgba(50, 43, 129, 0.6) !important;
  }
  .marker-cluster-small div {
    background-color: #322B81 !important;
    color: #FFCC00 !important;
    font-weight: 700 !important;
  }
  .marker-cluster-medium {
    background-color: rgba(50, 43, 129, 0.6) !important;
  }
  .marker-cluster-medium div {
    background-color: #322B81 !important;
    color: #FFCC00 !important;
    font-weight: 700 !important;
  }
  .marker-cluster-large {
    background-color: rgba(50, 43, 129, 0.6) !important;
  }
  .marker-cluster-large div {
    background-color: #322B81 !important;
    color: #FFCC00 !important;
    font-weight: 700 !important;
  }
  .marker-cluster {
    background-clip: padding-box !important;
    border-radius: 50% !important;
  }
  .marker-cluster div {
    width: 35px !important;
    height: 35px !important;
    margin-left: 5px !important;
    margin-top: 5px !important;
    text-align: center !important;
    border-radius: 50% !important;
    font-size: 16px !important;
    line-height: 35px !important;
  }

  /* Custom cluster + marker styles to match provided design (navy rings + yellow count) */
  .custom-cluster { background: transparent !important; }
  .custom-cluster .cluster-outer { 
    background: rgba(29, 43, 111, 0.85);
    border-radius: 50%;
    padding: 6px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.25);
  }
  .custom-cluster .cluster-inner {
    background: #322B81;
    color: #FFCC00;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-weight: 700; letter-spacing: 0.3px;
  }
  .custom-cluster.small .cluster-inner  { width: 34px; height: 34px; font-size: 14px; }
  .custom-cluster.medium .cluster-inner { width: 42px; height: 42px; font-size: 15px; }
  .custom-cluster.large .cluster-inner  { width: 52px; height: 52px; font-size: 16px; }

  /* Single marker (DivIcon) */
  .pharm-marker { background: transparent; }
  .pharm-marker .pin-outer { 
    background: rgba(29, 43, 111, 0.85);
    width: 26px; height: 26px; border-radius: 50%;
    display:flex; align-items:center; justify-content:center;
    box-shadow: 0 1px 5px rgba(0,0,0,0.25);
  }
  .pharm-marker .pin-inner {
    background: #322B81;
    width: 18px; height: 18px; border-radius: 50%;
    border: 2px solid #FFCC00;
  }
</style>

{%- comment -%}
  Internal hero removed. Use dedicated sections/hero.liquid placed by template.
{%- endcomment -%}

