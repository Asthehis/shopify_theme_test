    {% if section.settings.show_list %}
        <div class="ou-nous-trouver__list">
          <div class="ou-nous-trouver__search-wrapper">
            <input id="pharm-search-{{ section.id }}" type="text" placeholder="Code postal, ville ou nom..." />
            <button type="button" aria-label="Rechercher">
