              </svg>
            </button>
          </div>
          <ul id="pharm-list-{{ section.id }}"></ul>
        </div>
      {% endif %}

      <div id="ou-nous-trouver-map-{{ section.id }}" class="ou-nous-trouver__map"></div>

      {% if section.settings.data_source == 'manual' and section.settings.manual_json != blank %}
        <script id="pharmacies-json-{{ section.id }}" type="application/json">
          {{ section.settings.manual_json }}
        </script>
      {% endif %}
  </div>

  <div class="frame">
    <div class="cta">
      <div class="content">
        <div class="row">
          <div class="heading">Vous souhaitez devenir partenaire ?</div>
          <div class="text">
            Vous êtes une pharmacie ou un point de vente et vous souhaitez
            distribuer nos produits ? Remplissez notre formulaire, nous serons
            ravis d'échanger avec vous !
          </div>
        </div>
      </div>
      <div class="actions">
        <a href="https://form.typeform.com/to/y73Ss9Wz" class="button" target="_blank" rel="noopener noreferrer">
          <div class="devenir-partenaire">Devenir partenaire</div>
        </a>
      </div>
    </div>
  </div>
</div>

<!-- Leaflet assets -->
{% unless section.settings.disable_leaflet %}
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
  <!-- Leaflet MarkerCluster plugin -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css" />
  <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css" />
  <script src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"></script>
{% endunless %}

<script>
  (function(){
    var sectionId = '{{ section.id }}';
    var mapElId = 'ou-nous-trouver-map-' + sectionId;
    var listElId = 'pharm-list-' + sectionId;
    var searchElId = 'pharm-search-' + sectionId;

    // sample fallback data (vide - toutes les pharmacies doivent venir des metaobjects)
    var SAMPLE_DATA = [];

    // Retourne le nom tel quel sans ajout automatique de "Pharmacie"
    // Supporte pharmacies, instituts de beauté, magasins bio, etc.
    function computeDisplayName(raw){
      if(!raw) return 'Point de vente';
      var n = String(raw).trim();
      if(!n) return 'Point de vente';
      return n;
    }

    function ensureLeaflet(cb){
      if(window.L) return cb();
      var existing = document.querySelector('script[src*=\"leaflet\"]');
      if(existing){ existing.addEventListener('load', cb); return; }
      var css = document.createElement('link'); css.rel='stylesheet'; css.href='https://unpkg.com/leaflet@1.9.4/dist/leaflet.css'; document.head.appendChild(css);
      var js = document.createElement('script'); js.src='https://unpkg.com/leaflet@1.9.4/dist/leaflet.js'; js.onload = cb; js.onerror = function(){ console.error('Failed to load Leaflet from CDN'); cb(); }; document.head.appendChild(js);
    }

    function initMapWithData(data){
      var mapEl = document.getElementById(mapElId);
      if(!mapEl) { console.warn('map element not found', mapElId); return; }
      if(!mapEl.style.minHeight || parseInt(mapEl.style.minHeight) === 0) mapEl.style.minHeight = '600px';
      if(!window.L){ console.error('Leaflet not available'); return; }
      if (!data || !data.length) { console.warn('no data provided to map, showing sample'); data = SAMPLE_DATA; }
      
      // Adapter le zoom selon la taille de l'écran
      var isMobile = window.innerWidth <= 768;
      var isTablet = window.innerWidth > 768 && window.innerWidth <= 1024;
      
      // Zoom au clic sur un marqueur : moins proche sur mobile
      var markerClickZoom = isMobile ? 10 : (isTablet ? 12 : 14);
      
      // Créer la carte avec commandes en bas à droite
      var map = L.map(mapElId, { 
        scrollWheelZoom: true,
        zoomControl: false,
        minZoom: 2,
        maxZoom: 18,
        worldCopyJump: true
      }).setView([46.5, 2.5], 6); // Vue initiale temporaire
      
      // Définir les limites de la France métropolitaine (incluant Corse)
      // Sud-Ouest (Pyrénées) à Nord-Est (Alsace)
      var franceBounds = [
        [41.3, -5.5],  // Sud-Ouest (Corse sud + Pyrénées ouest)
        [51.1, 9.6]    // Nord-Est (Flandre + Alsace)
      ];
      
      // Ajuster le padding selon la taille de l'écran
      var padding = isMobile ? [20, 20] : (isTablet ? [40, 40] : [60, 60]);
      
      // Ajuster la vue pour afficher toute la France
      map.fitBounds(franceBounds, { 
        padding: padding,
        maxZoom: isMobile ? 6 : (isTablet ? 6 : 6) // Limite le zoom max lors du fit
      });

      // Prevent panning the map so far that the tile server returns empty tiles
      map.setMaxBounds([[-85, -180], [85, 180]]);
  
      L.control.zoom({ position: 'bottomright' }).addTo(map);
      
      // Tuiles: Stadia Alidade Smooth si clé API fournie, sinon OpenStreetMap
      var stadiaKey = '{{ section.settings.stadia_api_key }}' || 'dc4a2aa8-c371-43d1-9e5a-ac3f6a294849';
      if (stadiaKey && stadiaKey.trim() !== '') {
        // Utiliser Stadia avec la clé API
        L.tileLayer('https://tiles.stadiamaps.com/tiles/alidade_smooth/{z}/{x}/{y}{r}.png?api_key=' + stadiaKey, {
          minZoom: 0,
          maxZoom: 20,
          noWrap: false,
          detectRetina: true
        }).addTo(map);
      } else {
        // Fallback: OpenStreetMap (pas de clé requise)
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          maxZoom: 19,
          noWrap: false,
          detectRetina: true
        }).addTo(map);
      }
      
      // Créer le groupe de clusters
      var markerCluster = window.L.markerClusterGroup ? L.markerClusterGroup({
        maxClusterRadius: 40,
        spiderfyOnMaxZoom: true,
        showCoverageOnHover: false,
        zoomToBoundsOnClick: true
      }) : null;
      
      var markers = [];
      var listEl = document.getElementById(listElId);
      
      data.forEach(function(item){
        var lat = parseFloat(item.lat || item.latitude || item.y);
        var lng = parseFloat(item.lng || item.longitude || item.x);
        if (isNaN(lat) || isNaN(lng)) return;
        
        var marker = L.marker([lat, lng]);
  // Compute a display address (support legacy `address` or new `numero` + `rue` fields)
  var addrPartsForPopup = [];
  if (item.address && String(item.address).trim() !== '') {
    addrPartsForPopup.push(String(item.address).trim());
  } else {
    var num = item.numero ? String(item.numero).trim() : '';
    var rue = item.rue ? String(item.rue).trim() : '';
    var combined = (num ? (num + ' ') : '') + (rue || '');
    if (combined.trim() !== '') addrPartsForPopup.push(combined.trim());
  }
  var popupHtml = '<strong>' + computeDisplayName(item.name || 'Pharmacie') + '</strong>' + (addrPartsForPopup.length ? '<br/>' + addrPartsForPopup.join('<br/>') : '');
        if (item.url) popupHtml += '<br/><a href="' + item.url + '" style="color: #2e408b; font-weight: bold;">Voir la fiche →</a>';
        marker.bindPopup(popupHtml);
        
        // Ajouter au cluster si disponible, sinon à la carte
        if (markerCluster) {
          markerCluster.addLayer(marker);
        } else {
          marker.addTo(map);
        }
        
        markers.push({ marker: marker, lat: lat, lng: lng, item: item });
        
        // Liste à gauche
        if (listEl) {
          var li = document.createElement('li');
          
          var itemDiv = document.createElement('div');
          itemDiv.className = 'pharmacy-item';
          
          var icon = document.createElement('div');
          icon.className = 'pharmacy-item__icon';
          icon.innerHTML = '<svg width="19" height="25" viewBox="0 0 19 25" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8.35351 24.3267C1.30781 14.1125 0 13.0642 0 9.31034C0 4.16837 4.16837 0 9.31034 0C14.4523 0 18.6207 4.16837 18.6207 9.31034C18.6207 13.0642 17.3129 14.1125 10.2672 24.3267C9.80481 24.9946 8.81583 24.9945 8.35351 24.3267ZM9.31034 13.1897C11.4528 13.1897 13.1897 11.4528 13.1897 9.31034C13.1897 7.16785 11.4528 5.43103 9.31034 5.43103C7.16785 5.43103 5.43103 7.16785 5.43103 9.31034C5.43103 11.4528 7.16785 13.1897 9.31034 13.1897Z" fill="#333333"/></svg>';
          
          var content = document.createElement('div');
          content.className = 'pharmacy-item__content';
          
          var name = document.createElement('h3');
          name.textContent = computeDisplayName(item.name);
          
          var address = document.createElement('p');
          var addressParts = [];
          // Support legacy address field or new numero+rue
          if (item.address && String(item.address).trim() !== '') {
            addressParts.push(String(item.address).trim());
          } else {
            var num = item.numero ? String(item.numero).trim() : '';
            var rue = item.rue ? String(item.rue).trim() : '';
            var combined = (num ? (num + ' ') : '') + (rue || '');
            if (combined.trim() !== '') addressParts.push(combined.trim());
          }
          // Ajouter code postal + ville sur la même ligne
          var cityLine = '';
          if (item.postal_code) cityLine += item.postal_code + ' ';
          if (item.city) cityLine += item.city;
          if (cityLine.trim()) addressParts.push(cityLine.trim());
          // Afficher le pays s'il est différent de France
          var country = item.country ? String(item.country).trim() : '';
          if (country && country.toLowerCase() !== 'france' && country.toLowerCase() !== '') {
            addressParts.push(country);
          } else if (!country || country === '') {
            // Si pas de pays renseigné, vérifier le code postal pour détecter le pays
            var postalCode = String(item.postal_code || '').trim();
            // Codes postaux espagnols commencent généralement par 28xxx (Madrid), 08xxx (Barcelona), etc.
            if (postalCode.match(/^(0[1-9]|[1-4]\d|5[0-2])\d{3}$/)) {
              // Code postal espagnol (01000-52999)
              addressParts.push('Espagne');
            } else if (postalCode.match(/^(B-|L-)/i) || (postalCode.length === 4 && /^\d{4}$/.test(postalCode))) {
              // Code postal belge ou luxembourgeois
              if (item.city && item.city.toLowerCase().indexOf('luxemb') !== -1) {
                addressParts.push('Luxembourg');
              } else {
                addressParts.push('Belgique');
              }
            } else if (postalCode.match(/^(CH-|[1-9]\d{3})$/)) {
              // Code postal suisse
              addressParts.push('Suisse');
            }
          }
          address.innerHTML = addressParts.length > 0 ? addressParts.join('<br/>') : 'Adresse 1<br/>Adresse 2<br/>Adresse 3<br/>Pays';
          
          content.appendChild(name);
          content.appendChild(address);
          
          itemDiv.appendChild(icon);
          itemDiv.appendChild(content);
          li.appendChild(itemDiv);
          
          // Stocker les données de la pharmacie sur l'élément li pour la recherche
          li.dataset.postalCode = item.postal_code || '';
          li.dataset.city = (item.city || '').toLowerCase();
          li.dataset.name = computeDisplayName(item.name).toLowerCase();
          li.dataset.markerIndex = markers.length - 1;
          
          li.addEventListener('click', function(){ 
            map.setView([lat, lng], markerClickZoom); 
            marker.openPopup(); 
          });
          
          listEl.appendChild(li);
        }
      });
      
      // Ajouter le cluster à la carte
      if (markerCluster) {
        map.addLayer(markerCluster);
      }
      
      // Vue monde conservée (pas de fitBounds) pour correspondre à la maquette
      
      // Barre de recherche par code postal avec tri par proximité
      var search = document.getElementById(searchElId);
      if (search && listEl) {
        search.addEventListener('input', function(){
          var q = this.value.trim();
          
          if (q === '') {
            // Afficher tous les éléments de la liste
            Array.from(listEl.children).forEach(function(li){
              li.style.display = '';
            });
            
            // Afficher tous les marqueurs sur la carte
            if (markerCluster) {
              map.removeLayer(markerCluster);
              markerCluster.clearLayers();
              markers.forEach(function(m){ markerCluster.addLayer(m.marker); });
              map.addLayer(markerCluster);
            }
            return;
          }
          
          var matches = [];
          var qIsNumeric = /^\d+$/.test(q);
          var qNum = qIsNumeric ? parseInt(q) : null;
          
          Array.from(listEl.children).forEach(function(li){
            var postalCode = li.dataset.postalCode || '';
            var city = li.dataset.city || '';
            var name = li.dataset.name || '';
            var markerIndex = parseInt(li.dataset.markerIndex);
            
            var score = 10000;
            var isMatch = false;
            
            // Si la recherche est numérique (code postal)
            if (qIsNumeric && postalCode) {
              var postalNum = parseInt(postalCode);
              if (!isNaN(postalNum)) {
                // Calculer la distance numérique entre les codes postaux
                var distance = Math.abs(postalNum - qNum);
                
                // Match si commence pareil OU si distance < 1000 (ex: 68000 vs 68200)
                if (postalCode.indexOf(q) === 0 || distance < 1000) {
                  isMatch = true;
                  score = distance;
                }
              }
            }
            
            // Recherche par ville ou nom (toujours actif)
            if (city.indexOf(q.toLowerCase()) !== -1) {
              isMatch = true;
              if (city.indexOf(q.toLowerCase()) === 0) {
                score = Math.min(score, 200); // Match au début de la ville
              } else {
                score = Math.min(score, 300);
              }
            }
            
            if (name.indexOf(q.toLowerCase()) !== -1) {
              isMatch = true;
              score = Math.min(score, 500);
            }
            
            // Si code postal contient la recherche mais pas numérique (ex: "Paris" dans "75001 Paris")
            if (!qIsNumeric && postalCode.indexOf(q) !== -1) {
              isMatch = true;
              score = Math.min(score, 100);
            }
            
            if (isMatch) {
              matches.push({ li: li, score: score, markerIndex: markerIndex });
            } else {
              li.style.display = 'none';
            }
          });
          
          // Trier par score (plus proche = score plus bas)
          matches.sort(function(a, b){ return a.score - b.score; });
          
          // Afficher les résultats triés (limiter à 10 pour performance)
          var visibleMarkers = [];
          matches.forEach(function(match, idx){
            if (idx < 10) {
              match.li.style.display = '';
              if (!isNaN(match.markerIndex) && markers[match.markerIndex]) {
                visibleMarkers.push(markers[match.markerIndex]);
              }
            } else {
              match.li.style.display = 'none';
            }
          });
          
          // Mettre à jour la carte pour n'afficher que les marqueurs correspondants
          if (markerCluster) {
            map.removeLayer(markerCluster);
            markerCluster.clearLayers();
            visibleMarkers.forEach(function(m){ markerCluster.addLayer(m.marker); });
            map.addLayer(markerCluster);
            
            // Zoomer sur les résultats si au moins un marqueur visible
            if (visibleMarkers.length > 0) {
              var bounds = L.latLngBounds(visibleMarkers.map(function(m){ 
                return [m.lat, m.lng]; 
              }));
              map.fitBounds(bounds, { padding: [50, 50], maxZoom: 14 });
            }
          }
        });
      }
    }

    function tryLoad(){
      // Appel direct à l'endpoint du worker Cloudflare qui lit les metaobjects en temps réel
      var workerUrl = 'https://pharmacy-sync-webhook.pharmacy-sync-webhook.workers.dev/pharmacies';
      
      fetch(workerUrl)
        .then(function(r){ 
          if(!r.ok) return Promise.reject('Worker status: ' + r.status); 
          return r.json(); 
        })
        .then(function(json){ 
          // Le worker retourne { count: X, pharmacies: [...] }
          var data = json.pharmacies || json;
          console.log('✅ Pharmacies chargées depuis metaobjects:', data.length);
          ensureLeaflet(function(){ initMapWithData(data); }); 
        })
        .catch(function(e){
          console.warn('❌ Échec du chargement depuis le worker, utilisation des données de secours', e);
          
          // Fallback: essayer assets/pharmacies.json si configuré
          {% if section.settings.data_source == 'asset' and section.settings.asset_filename != blank %}
            var assetUrl = {{ section.settings.asset_filename | replace: 'assets/', '' | asset_url | json }};
            fetch(assetUrl)
              .then(function(r){ if(!r.ok) throw new Error('Asset status: ' + r.status); return r.json(); })
              .then(function(json){ 
                console.log('✅ Fallback: pharmacies chargées depuis asset');
                ensureLeaflet(function(){ initMapWithData(json); }); 
              })
              .catch(function(e2){
                console.warn('❌ Asset aussi en échec, utilisation SAMPLE_DATA', e2);
                ensureLeaflet(function(){ initMapWithData(SAMPLE_DATA); });
              });
          {% else %}
            // Essayer le JSON manuel si configuré
            var el = document.getElementById('pharmacies-json-{{ section.id }}');
            if(el){ 
              try{ 
                var data = JSON.parse(el.textContent); 
                console.log('✅ Fallback: pharmacies depuis JSON manuel');
                ensureLeaflet(function(){ initMapWithData(data); }); 
              } catch(err){ 
                console.error('JSON manuel invalide', err); 
                ensureLeaflet(function(){ initMapWithData(SAMPLE_DATA); }); 
              }
            } else {
              ensureLeaflet(function(){ initMapWithData(SAMPLE_DATA); });
            }
          {% endif %}
        });
    }

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', tryLoad); else tryLoad();
  })();
</script>

{% schema %}
{
  "name": "Où nous trouver (carte)",
  "settings": [
    {
      "type": "select",
      "id": "data_source",
      "label": "Source des données",
      "options": [
        { "value": "asset", "label": "Fichier d'asset (assets/pharmacies.json)" },
        { "value": "manual", "label": "JSON manuel (coller dans la section)" }
      ],
      "default": "asset"
    },
    {
      "type": "text",
      "id": "asset_filename",
      "label": "Nom du fichier asset",
      "default": "assets/pharmacies.json"
    },
    {
      "type": "textarea",
      "id": "manual_json",
      "label": "JSON manuel (exemple)",
      "info": "Si vous choisissez 'JSON manuel', collez ici le tableau JSON"
    },
    {
      "type": "checkbox",
      "id": "show_list",
      "label": "Afficher la liste à gauche",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "disable_leaflet",
      "label": "Désactiver le chargement de Leaflet (si inclus)",
      "default": false
    },
    {
      "type": "text",
      "id": "stadia_api_key",
      "label": "Clé API Stadia Maps (optionnel)",
      "info": "Obtenez une clé gratuite sur stadiamaps.com. Si vide, la carte utilisera OpenStreetMap."
    }
  ],
  "blocks": [],
  "max_blocks": 10
}
{% endschema %}