            "title": "Abonnement",
            "subheading": "",
            "text": "<p>L'abonnement üma c'est l'assurance de toujours avoir vos produits préférés à portée de main. </p>",
            "width": "33%",
            "alignment": "center",
            "align_text": "left",
            "text_size": "medium",
