        "7d3b164a-a48b-4820-821b-1f08ecb6255d": {
          "type": "html",
          "settings": {
            "code": "<div class=\"sf__tabs-custom\">\n  <div class=\"sf__tab-item\">\n        <input type=\"checkbox\" id=\"chck8\" checked>\n        <label class=\"sf__tab-item-label\" for=\"chck8\"><b>Quels modes de paiement acceptez-vous ?</b></label>\n        <div class=\"sf__tab-item-content\">\n          Nous acceptons actuellement les paiements par toutes les principales cartes de crédit (Visa, Visa Débit, Mastercard et American Express.). Nous vous proposons également les paiements via Paypal, Apple Pay ainsi que Google Pay.\n        </div>\n      </div>\n  <div class=\"sf__tab-item\">\n        <input type=\"checkbox\" id=\"chck9\">\n        <label class=\"sf__tab-item-label\" for=\"chck9\"><b>Quand ma carte sera-t-elle débitée ?</b></label>\n<div class=\"sf__tab-item-content\">\n          Votre carte sera débitée lorsque votre commande quittera notre entrepôt.\nVeuillez noter que si vous avez passé une précommande, votre carte sera débitée au moment du paiement. Nous vous informerons ensuite de l'expédition de votre commande depuis notre entrepôt.\n        </div>\n      </div>\n</div>",
