    "16414143576e8c1955": {
      "type": "custom-content",
      "blocks": {
        "045badf7-afd1-4dba-a0bf-16996dccbff7": {
          "type": "html",
          "settings": {
            "code": "<div class=\"sf__about-custom-list\">\n  <ul>\n    <li>\n      <span><img src=\"https://cdn.shopify.com/s/files/1/0602/7365/6017/files/check-box-product-page.png?v=1653042822\"></span>\n      <div class=\"rte\">\n          <h4>Des actifs brevetés et innovants</h4>\n          <p class=\"text-color-subtext\">Les ingrédients que nous utilisons sont le fruit de recherches et développements approfondies. L'efficacité de nos actifs a été certifiée par des essais cliniques réalisés par des laboratoires indépendants.</p>\n      </div>\n    </li>\n    <li>\n      <span><img src=\"https://cdn.shopify.com/s/files/1/0602/7365/6017/files/check-box-product-page.png?v=1653042822\"></span>\n      <div class=\"rte\">\n          <h4>Sans hormone, sûrs et efficaces</h4>\n          <p class=\"text-color-subtext\"> Nous utilisons des ingrédients 100% d'origine naturelle, totalement exempts d'hormones et sans effets secondaires. Nous faisons le choix d’actifs d'origine naturelle premium hyper-sourcés, certifiés et tracés.</p>\n      </div>\n    </li>\n    <li>\n      <span><img src=\"https://cdn.shopify.com/s/files/1/0602/7365/6017/files/check-box-product-page.png?v=1653042822\"></span>\n      <div class=\"rte\">\n          <h4>Le choix de 60 000 femmes</h4>\n          <p class=\"text-color-subtext\"> Nos compléments alimentaires ont aidé des milliers de femmes à se sentir mieux avant, pendant et après la ménopause.</p>\n      </div>\n    </li>\n  </ul>\n</div>",
            "width": "50%",
            "block_custom_class": "sf__about-custom-html",
            "animations": "inherit"
