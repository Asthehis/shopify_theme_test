    "16442254616239dea1": {
      "type": "image-with-text-2",
      "settings": {
        "container": "w-full",
        "hero_size": "medium",
        "show_overlay": false,
        "image": "shopify://shop_images/yellow-box-uma.png",
        "bg_position": "center",
