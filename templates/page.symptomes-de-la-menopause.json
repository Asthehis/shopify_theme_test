    "16442325218c744363": {
      "type": "image-with-text-2",
      "settings": {
        "container": "w-full",
        "hero_size": "large",
        "show_overlay": false,
        "image": "shopify://shop_images/blue-box-uma.png",
        "bg_position": "center",
        "image_link": "",
