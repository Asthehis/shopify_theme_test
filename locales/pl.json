      "x-s57as851-text_html": "<p>Bez pestycydów</p>",
      "x-2hfd7ql4-title_html": "<p>Kołatanie serca</p>",
      "x-chuer3pp-text_html": "<p><span contenteditable=\"false\">Bez GMO</span></p>",
      "x-xagywdmd-title_html": "<p>Zaburzenia układu moczowego</p>",
      "x-8j85wg4z-title_html": "<p>Przyrost masy ciała</p>",
      "x-7fy7xmho-title_html": "<p>Problemy trawienne</p>",
      "x-izlduzok-title_html": "<p>Suchość pochwy</p>",
